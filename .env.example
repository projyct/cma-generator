# Application Access Control
# Set a strong password to protect the app from unauthorized access
# This password will be required on the login screen
APP_PASSWORD=your_secure_password_here

# RentCast API Configuration
# Get your API key from: https://app.rentcast.io/app/api
# Free tier: 50 API requests/month (each returns up to 25 comparables)
RENTCAST_API_KEY=your_rentcast_api_key_here

# Geocoding Settings (Nominatim)
# Email for Nominatim usage policy compliance
GEOCODING_EMAIL=your_email@example.com

# Google Drive Integration (Optional)
# Enables "Edit in Google Docs" export feature
# See GOOGLE_DOCS_SETUP.md for detailed setup instructions
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8501
